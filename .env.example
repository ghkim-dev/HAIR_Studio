# .env 로 복사해서 사용. .env 는 공유·업로드 금지.
OASH_API_KEY=sk-dev-여기에_개발키
OASH_BASE_URL=https://open.hasa.re.kr/v1

# 비워 두면 /v1/models 에서 역할별로 자동 선택
OASH_TEXT_MODEL=
OASH_VISION_MODEL=
OASH_IMAGE_MODEL=
OASH_IMAGE_EDIT_MODEL=
# 사진→영상은 i2v, 텍스트→영상은 t2v 모델이 자동 선택됨. 지정하려면 아래에
OASH_VIDEO_MODEL=

# 키의 동시 요청 한도 (개발키 1건). 실증키·운영키로 한도가 늘면 같이 올리세요
OASH_MAX_CONCURRENCY=1
OASH_IMAGE_STEPS=20
OASH_TIMEOUT=600

# 박람회 서버 빠른 모드 (auto: 동시 한도 1이면 켬)
EXPO_FAST=auto
